# Disposición de pantallas. La vertical gira 270º (con 90º quedaba boca abajo en la instalación de la oficina).
profile dual {
  output HDMI-A-1 enable mode 1920x1080@60Hz position 0,0
  output HDMI-A-2 enable mode 1920x1080@60Hz position 1920,0 transform 270
}
profile single {
  output HDMI-A-1 enable mode 1920x1080@60Hz position 0,0
}
